@inproceedings{smith2023microservices,
  author = {Smith, John and Doe, Jane},
  title = {A Systematic Mapping Study on Microservice Architecture Patterns},
  booktitle = {Proceedings of the International Conference on Software Engineering},
  year = {2023},
  pages = {100--115},
  doi = {10.1145/1234567.1234568},
  abstract = {This paper presents a systematic mapping study of microservice architecture patterns used in industry and academia. We identified 45 primary studies and classified them according to pattern type, quality attributes addressed, and evaluation methods used.},
  keywords = {microservices, software architecture, design patterns}
}

@article{johnson2022devops,
  author = {Johnson, Alice and Williams, Bob and Chen, Li},
  title = {DevOps Practices in Large-Scale Software Development: A Survey},
  journal = {IEEE Transactions on Software Engineering},
  year = {2022},
  volume = {48},
  number = {3},
  pages = {1024--1042},
  doi = {10.1109/TSE.2022.1234567},
  abstract = {We survey DevOps practices adopted by large-scale software development organizations. Our findings reveal that continuous integration and continuous deployment are the most widely adopted practices, while infrastructure as code adoption varies significantly across organizations.},
  keywords = {DevOps, continuous integration, software engineering}
}

@inproceedings{garcia2024testing,
  author = {Garcia, Maria and Brown, Robert},
  title = {Testing Strategies for Cloud-Native Applications},
  booktitle = {ACM SIGSOFT Symposium on Foundations of Software Engineering},
  year = {2024},
  pages = {200--214},
  doi = {10.1145/9876543.9876544},
  abstract = {Cloud-native applications present unique testing challenges due to their distributed nature and dynamic scaling. This paper proposes a testing framework that addresses these challenges through contract testing, chaos engineering, and observability-driven testing approaches.},
  keywords = {cloud-native, testing, microservices, chaos engineering}
}
