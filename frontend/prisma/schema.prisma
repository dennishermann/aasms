generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ STUDY & RESEARCH QUESTIONS ============

model Study {
  id                      String                   @id @default(uuid())
  title                   String
  description             String?
  status                  StudyStatus              @default(DRAFT)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  motivation              String?
  importStatistics        Json?
  researchQuestions       ResearchQuestion[]
  sources                 Source[]
  parameters              StudyParameters?
  importBatches           ImportBatch[]
  facets                  Facet[]
  analysisConfigurations  AnalysisConfiguration[]
  searchProtocolEntries   SearchProtocolEntry[]
}

model ResearchQuestion {
  id       String                  @id @default(uuid())
  studyId  String
  question String
  order    Int
  study    Study                   @relation(fields: [studyId], references: [id], onDelete: Cascade)
  facets   FacetResearchQuestion[]

  @@index([studyId])
}

// ============ STUDY PARAMETERS ============

model StudyParameters {
  id                String               @id @default(uuid())
  studyId           String               @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  exclusionCriteria ExclusionCriterion[]
  formalSources     FormalSource[]
  greySources       GreySource[]
  inclusionCriteria InclusionCriterion[]
  study             Study                @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
}

model FormalSource {
  id           String           @id @default(uuid())
  parametersId String
  name         String
  type         FormalSourceType
  searchString String?
  dateRange    Json?
  parameters   StudyParameters  @relation(fields: [parametersId], references: [id], onDelete: Cascade)

  @@index([parametersId])
}

model GreySource {
  id             String          @id @default(uuid())
  parametersId   String
  name           String
  type           GreySourceType
  url            String?
  searchStrategy String?
  parameters     StudyParameters @relation(fields: [parametersId], references: [id], onDelete: Cascade)

  @@index([parametersId])
}

model InclusionCriterion {
  id           String          @id @default(uuid())
  parametersId String
  criterion    String
  order        Int
  parameters   StudyParameters @relation(fields: [parametersId], references: [id], onDelete: Cascade)

  @@index([parametersId])
}

model ExclusionCriterion {
  id           String          @id @default(uuid())
  parametersId String
  criterion    String
  order        Int
  parameters   StudyParameters @relation(fields: [parametersId], references: [id], onDelete: Cascade)

  @@index([parametersId])
}

// ============ FACETS & CATEGORIES ============

model Facet {
  id                  String                  @id @default(uuid())
  studyId             String
  name                String
  description         String?
  type                FacetType               @default(CLOSED)
  required            Boolean                 @default(true)
  order               Int                     @default(0)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  // Coding fields for OPEN_CODED facets
  codingEnabled       Boolean                 @default(false)
  autoAssignThreshold Float?                  @default(0.8)
  codingCreatedAt     DateTime?
  // Metadata binding fields
  metadataField       String?                 // e.g., "publicationDate", "venue", "venueType"
  metadataTransform   String?                 // e.g., "year", "month" for date extraction
  study               Study                   @relation(fields: [studyId], references: [id], onDelete: Cascade)
  categories          FacetCategory[]
  researchQuestions   FacetResearchQuestion[]
  classifications     Classification[]
  facetKeywords       FacetKeyword[]
  facetKeywordMappings FacetKeywordMapping[]

  @@index([studyId])
}

model FacetCategory {
  id              String           @id @default(uuid())
  facetId         String
  name            String
  description     String?
  order           Int              @default(0)
  facet           Facet            @relation(fields: [facetId], references: [id], onDelete: Cascade)
  classifications Classification[]
  keywordMappings FacetKeywordMapping[]

  @@unique([facetId, name])
  @@index([facetId])
}

// Join table for many-to-many Facet <-> ResearchQuestion
model FacetResearchQuestion {
  id                 String           @id @default(uuid())
  facetId            String
  researchQuestionId String
  facet              Facet            @relation(fields: [facetId], references: [id], onDelete: Cascade)
  researchQuestion   ResearchQuestion @relation(fields: [researchQuestionId], references: [id], onDelete: Cascade)

  @@unique([facetId, researchQuestionId])
  @@index([facetId])
  @@index([researchQuestionId])
}

enum FacetType {
  CLOSED     // Must choose from predefined categories
  OPEN       // Free text / LLM-generated value
  OPEN_CODED // OPEN facet with user-created categories from values
}

// ============ SOURCES ============

model Source {
  id                     String              @id @default(uuid())
  studyId                String
  type                   SourceType
  sourceCategory         SourceCategory
  originalUrl            String?
  storagePath            String?
  classificationFileId   String?
  classificationThreadId String?
  hasPdf                 Boolean             @default(false)
  title                  String
  authors                String[]
  publicationDate        DateTime?
  venue                  String?
  venueType              VenueType?
  doi                    String?
  abstract               String?
  keywords               String[]
  sourceOrigin           String?
  sourceOrigins          String[]            @default([])
  importBatchId          String?
  needsPdf               Boolean             @default(false)
  allowMetadataOnlyClassification Boolean     @default(false)
  status                 SourceStatus        @default(PENDING)
  greyLiteratureTier     GreyLiteratureTier?
  metadataExtension      Json?
  metadataParsed         Json?
  metadataChosen         Json?
  metadataChosenSource   String?
  finalDecision          Decision?
  decisionRationale      String?
  bibtex                 String?
  decisionMadeAt         DateTime?
  uploadedAt             DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  study                  Study               @relation(fields: [studyId], references: [id], onDelete: Cascade)
  importBatch            ImportBatch?        @relation("ImportBatchSources", fields: [importBatchId], references: [id])
  analysis               SourceAnalysis?

  @@index([studyId])
  @@index([status])
  @@index([importBatchId])
}

enum GreyLiteratureTier {
  TIER_1 // High credibility (academic blogs, official industry reports)
  TIER_2 // Moderate credibility (company websites, news articles)
  TIER_3 // Lower credibility (personal blogs, forums)
}

enum VenueType {
  JOURNAL
  CONFERENCE
  WORKSHOP
  SYMPOSIUM
  BOOK_CHAPTER
  PREPRINT_SERVER
  TECHNICAL_REPORT
  BLOG
  OTHER
}

// ============ ANALYSIS & CLASSIFICATIONS ============

model SourceAnalysis {
  id                      String               @id @default(uuid())
  sourceId                String               @unique
  extractedText           String
  inclusionRecommendation Boolean
  inclusionReasoning      String
  exclusionReasoning      String
  confidenceScore         Float
  relevanceScore          Float?
  qualityNotes            String?
  classificationBasis     ClassificationBasis?
  isUserEdited            Boolean              @default(false)
  editedFields            String[]
  analysisDate            DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  exclusionCriteria       Json?
  inclusionCriteria       Json?
  // Voting fields
  votingEnabled           Boolean              @default(false)
  votingSummary           Json?                // VotingSummary as JSON
  classifications         Classification[]
  facetKeywords           FacetKeyword[]
  votes                   AnalysisVote[]
  source                  Source               @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

// ============ MULTI-LLM VOTING ============

model AnalysisVote {
  id              String         @id @default(uuid())
  analysisId      String
  criterionType   CriterionType  // INCLUSION or EXCLUSION
  criterionIndex  Int            // Index of criterion in the list
  criterionText   String         // The criterion text being evaluated
  provider        String         // "openai", "claude", "gemini"
  decision        Boolean        // The LLM's decision
  confidence      Float          // Confidence score (0-1)
  reasoning       String?        // Reasoning for the decision
  error           String?        // Error message if the vote failed
  createdAt       DateTime       @default(now())
  analysis        SourceAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([analysisId, criterionType])
  @@index([provider])
}

enum CriterionType {
  INCLUSION
  EXCLUSION
}

model Classification {
  id               String          @id @default(uuid())
  analysisId       String
  facetId          String
  categoryId       String?
  value            String?         // For OPEN facets - LLM-generated value
  rawValue         String?         // Original value before any coding (preserved)
  confidence       Float
  reasoning        String?
  isManualOverride Boolean         @default(false)
  autoAssigned     Boolean         @default(false)  // Was this category auto-assigned by coding?
  needsReview      Boolean         @default(false)  // Flagged for user review (low confidence)
  createdAt        DateTime        @default(now())
  analysis         SourceAnalysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  facet            Facet           @relation(fields: [facetId], references: [id], onDelete: Cascade)
  category         FacetCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([analysisId])
  @@index([facetId])
  @@index([categoryId])
  @@index([needsReview])
}

model FacetKeyword {
  id         String         @id @default(uuid())
  analysisId String
  facetId    String
  keyword    String
  confidence Float?
  evidence   String?
  createdAt  DateTime       @default(now())
  analysis   SourceAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  facet      Facet          @relation(fields: [facetId], references: [id], onDelete: Cascade)

  @@unique([analysisId, facetId, keyword])
  @@index([analysisId])
  @@index([facetId])
}

model FacetKeywordMapping {
  id                         String               @id @default(uuid())
  facetId                    String
  keyword                    String
  categoryId                 String?
  status                     KeywordMappingStatus @default(PENDING)
  confidence                 Float?
  source                     KeywordMappingSource @default(LLM)
  proposedCategoryName       String?
  proposedCategoryDescription String?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  facet                      Facet                @relation(fields: [facetId], references: [id], onDelete: Cascade)
  category                   FacetCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([facetId, keyword])
  @@index([facetId])
  @@index([categoryId])
  @@index([status])
}

// ============ ANALYSIS CONFIGURATIONS ============

model AnalysisConfiguration {
  id          String   @id @default(uuid())
  studyId     String
  name        String
  description String?
  artifacts   Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  study       Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
}

// ============ IMPORT BATCHES ============

model ImportBatch {
  id                    String       @id @default(uuid())
  studyId               String
  databaseSource        String
  fileName              String
  status                ImportStatus @default(PROCESSING)
  totalRecords          Int          @default(0)
  duplicates            Int          @default(0)
  newSources            Int          @default(0)
  relevant              Int          @default(0)
  irrelevant            Int          @default(0)
  needsPdf              Int          @default(0)
  errors                Int          @default(0)
  errorLog              Json?
  startedAt             DateTime     @default(now())
  completedAt           DateTime?
  study                 Study        @relation(fields: [studyId], references: [id], onDelete: Cascade)
  sources               Source[]     @relation("ImportBatchSources")
  searchProtocolEntry   SearchProtocolEntry?

  @@index([studyId])
  @@index([status])
}

// ============ SEARCH PROTOCOL ============

model SearchProtocolEntry {
  id            String    @id @default(uuid())
  studyId       String
  database      String    // e.g., "IEEE Xplore", "ACM Digital Library", "Scopus"
  searchString  String    @db.Text // The actual query string used
  dateSearched  DateTime  // When the search was performed
  dateRangeFrom DateTime? // Optional: publication date filter start
  dateRangeTo   DateTime? // Optional: publication date filter end
  totalResults  Int?      // How many hits the search returned
  notes         String?   @db.Text // Any notes about this search
  importBatchId String?   @unique // Optional link to an ImportBatch

  study         Study     @relation(fields: [studyId], references: [id], onDelete: Cascade)
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([studyId])
}

// ============ ENUMS ============

enum StudyStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum FormalSourceType {
  ACADEMIC_DATABASE
  JOURNAL
  CONFERENCE_PROCEEDINGS
}

enum GreySourceType {
  BLOG
  WHITE_PAPER
  TECHNICAL_REPORT
  PREPRINT_SERVER
  COMPANY_WEBSITE
  RESEARCH_LAB_SITE
  GOVERNMENT_REPORT
}

enum SourceType {
  PDF
  WEBPAGE
  PREPRINT
  TECHNICAL_REPORT
  WHITE_PAPER
  BLOG_POST
}

enum SourceCategory {
  FORMAL
  GREY
}

enum SourceStatus {
  PENDING
  ANALYZING
  ANALYZED
  INCLUDED
  EXCLUDED
  NEEDS_REVIEW
  EXTRACTING_METADATA
  PENDING_METADATA
  READY_FOR_ANALYSIS
  ANALYZING_INCLUSION
  ANALYZING_CLASSIFICATION
  CLASSIFIED
  READY_FOR_CLASSIFICATION
  CLASSIFYING
}

enum Decision {
  INCLUDE
  EXCLUDE
}

enum ClassificationBasis {
  FULL_TEXT
  METADATA_ONLY
}

enum KeywordMappingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KeywordMappingSource {
  LLM
  USER
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

